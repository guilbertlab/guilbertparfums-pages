---
interface Props {
  variant?: "over-hero-light" | "over-hero-dark" | "solid";
}
const { variant = "over-hero-light" } = Astro.props;

const isDark = variant === "over-hero-dark";
const tone = isDark ? "text-white/90" : "text-[var(--color-ink)]";
const logo = "/logo/logo-guilbert.png";
const borderTone = isDark
  ? "border-white/40"
  : "border-[var(--color-ink)]/25";
const hoverBg = isDark
  ? "hover:bg-white hover:text-[var(--color-ink)]"
  : "hover:bg-[var(--color-ink)] hover:text-[var(--color-ivory)]";
---

<header
  data-header
  class={`site-header fixed inset-x-0 top-0 z-50 ${tone}`}
>
  <div
    class="header-inner mx-auto flex max-w-[1480px] items-center justify-between px-6 py-5 md:px-10 md:py-7"
  >
    <a href="/" class="block" aria-label="Guilbert Parfums">
      <img
        src={logo}
        alt="Guilbert Parfums"
        width="54"
        height="40"
        class="h-[40px] w-auto md:h-[64px]"
      />
    </a>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href="tel:+33686537497"
        aria-label="Appeler Guilbert Parfums"
        class={`inline-flex items-center justify-center border ${borderTone} p-2.5 transition-colors duration-300 ${hoverBg}`}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center bg-[var(--color-ink)] px-5 py-2.5 text-[11px] font-medium tracking-[0.01em] text-white transition-colors duration-300 hover:bg-black"
      >
        Devis gratuit
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 400ms ease,
      backdrop-filter 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease;
  }

  .site-header .header-inner {
    transition: padding 400ms ease;
  }

  .site-header.is-scrolled {
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 24px -12px rgba(26, 26, 26, 0.25);
  }

  @media (min-width: 768px) {
    .site-header.is-scrolled .header-inner {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  .site-header.is-scrolled .header-inner {
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    let ticking = false;
    const apply = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 48);
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(apply);
          ticking = true;
        }
      },
      { passive: true }
    );
    apply();
  }
</script>
