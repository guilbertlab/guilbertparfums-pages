---
import { Image } from "astro:assets";
import processBg from "../assets/vapeur.png";

type Step = {
  n: string;
  title: string;
  desc: string;
};

const steps: Step[] = [
  {
    n: "01",
    title: "Audit olfactif offert",
    desc: "À distance ou à notre showroom parisien, sans engagement.",
  },
  {
    n: "02",
    title: "Composition en France",
    desc: "Plusieurs propositions de parfums adaptés à votre besoin.",
  },
  {
    n: "03",
    title: "Installation & pilotage",
    desc: "Sur place, partout en France. Tout se règle depuis l'application.",
  },
  {
    n: "04",
    title: "Suivi & évolution",
    desc: "Recharges, ajustements, et déclinaison de votre gamme.",
  },
];
---

<section
  id="etapes"
  data-process
  aria-labelledby="process-title"
  class="relative isolate scroll-mt-24 overflow-hidden bg-white md:scroll-mt-28"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Image
      src={processBg}
      alt=""
      widths={[768, 1280, 1920, 2537]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 [background:linear-gradient(to_bottom,rgba(255,255,255,0.92),rgba(255,255,255,0.8)_50%,rgba(255,255,255,0.95))]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <h2
      id="process-title"
      data-process-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="font-display font-light leading-[1.1] tracking-[-0.015em] text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-ink)]"
    >
      De l'audit à la diffusion
    </h2>

    <ol class="relative mt-14 grid grid-cols-1 gap-y-10 md:mt-20 md:grid-cols-4 md:gap-x-8">
      <span
        class="absolute left-0 right-0 top-[22px] hidden h-px bg-[var(--color-border)] md:block"
        aria-hidden="true"></span>

      {steps.map((s) => (
        <li
          data-process-step
          style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
          class="relative flex items-start gap-5 md:flex-col md:gap-0"
        >
          <span
            class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[var(--color-ink)] bg-white font-display text-[0.8125rem] tracking-[0.04em] text-[var(--color-ink)]"
          >
            {s.n}
          </span>
          <div class="md:mt-6">
            <h3
              class="font-display text-[1.1875rem] font-light leading-[1.25] tracking-[-0.01em] text-[var(--color-ink)] md:text-[1.3125rem]"
            >
              {s.title}
            </h3>
            <p
              class="mt-2.5 text-[0.9375rem] font-light leading-[1.6] text-[var(--color-ink-soft)] md:max-w-[26ch]"
            >
              {s.desc}
            </p>
          </div>
        </li>
      ))}
    </ol>

    <div
      data-process-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="mt-14 md:mt-16"
    >
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 bg-[var(--color-ink)] px-7 py-4 text-[12px] font-medium tracking-[0.01em] text-white transition-colors duration-300 hover:bg-black"
      >
        <span>Créer et diffuser mon parfum</span>
        <svg
          width="16"
          height="10"
          viewBox="0 0 16 10"
          fill="none"
          class="transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path
            d="M0 5h14m0 0L10 1m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.4"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-process-reveal], [data-process-step]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    gsap.to("[data-process-reveal]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-process]",
        start: "top 78%",
        once: true,
      },
    });

    gsap.to("[data-process-step]", {
      opacity: 1,
      y: 0,
      duration: 0.7,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-process-step]",
        start: "top 84%",
        once: true,
      },
    });
  }
</script>
