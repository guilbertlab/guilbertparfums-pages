---
type Differentiator = {
  title: string;
  desc: string;
  icon: string;
};

const differentiators: Differentiator[] = [
  {
    title: "100% huile de parfum",
    desc: "Sans dilution, contrairement à la concurrence. Plus de tenue, plus de profondeur, une présence qui ne s'évente pas.",
    icon: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
  },
  {
    title: "Fabriqué en France",
    desc: "Élaboré dans le berceau historique de la parfumerie, à Grasse. Rien n'est sous-traité à l'étranger.",
    icon: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/>',
  },
  {
    title: "Diffuseur connecté piloté par application",
    desc: "Intensité, plages horaires, zones : tout se règle via votre application, à tout moment.",
    icon: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>',
  },
  {
    title: "Disponible partout en France",
    desc: "Audit, installation et suivi dans toute la France. Showroom olfactif à disposition sur rendez-vous.",
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  {
    title: "Adapté à vos contraintes techniques",
    desc: "Surface atypique, ventilation difficile, cadre réglementaire strict : la solution se construit autour de votre lieu.",
    icon: '<line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="2" x2="6" y1="14" y2="14"/><line x1="10" x2="14" y1="8" y2="8"/><line x1="18" x2="22" y1="16" y2="16"/>',
  },
  {
    title: "Une diffusion à froid",
    desc: "Diffusion sans aucun chauffage permettant de conserver l'intégrité du parfum pour que chaque note demeure intacte et révèle toute sa subtilité.",
    icon: '<line x1="2" x2="22" y1="12" y2="12"/><line x1="12" x2="12" y1="2" y2="22"/><path d="m20 16-4-4 4-4"/><path d="m4 8 4 4-4 4"/><path d="m16 4-4 4-4-4"/><path d="m8 20 4-4 4 4"/>',
  },
];
---

<section
  data-why
  aria-labelledby="why-title"
  class="relative bg-white"
>
  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <h2
      id="why-title"
      data-why-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="font-display font-light leading-[1.1] tracking-[-0.015em] text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-ink)]"
    >
      Pourquoi choisir Guilbert Parfums
    </h2>

    <ul
      class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 md:mt-16 md:grid-cols-3 md:gap-6"
    >
      {differentiators.map((d) => (
        <li
          data-why-card
          style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
          class="flex flex-col border border-[var(--color-border)] bg-[var(--color-ivory-50)] p-7 md:p-8"
        >
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--color-ink)"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={d.icon}
          />
          <h3
            class="mt-6 font-display text-[1.1875rem] font-light leading-[1.25] tracking-[-0.01em] text-[var(--color-ink)]"
          >
            {d.title}
          </h3>
          <p
            class="mt-3 text-[0.9375rem] font-light leading-[1.6] text-[var(--color-ink-soft)]"
          >
            {d.desc}
          </p>
        </li>
      ))}
    </ul>

    <div
      data-why-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="mt-12 md:mt-14"
    >
      <a
        href="#form"
        class="group inline-flex items-center gap-3 bg-[var(--color-ink)] px-7 py-4 text-[12px] font-medium tracking-[0.01em] text-white transition-colors duration-300 hover:bg-black"
      >
        <span>Créer et diffuser mon parfum</span>
        <svg
          width="16"
          height="10"
          viewBox="0 0 16 10"
          fill="none"
          class="transition-transform duration-300 group-hover:translate-x-1"
          aria-hidden="true"
        >
          <path
            d="M0 5h14m0 0L10 1m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.4"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-why-reveal], [data-why-card]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    gsap.to("[data-why-reveal]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-why]",
        start: "top 78%",
        once: true,
      },
    });

    gsap.to("[data-why-card]", {
      opacity: 1,
      y: 0,
      duration: 0.75,
      stagger: 0.1,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-why-card]",
        start: "top 82%",
        once: true,
      },
    });
  }
</script>
