---
import { Image } from "astro:assets";
import diffuseur from "../assets/photo-diffuseur-fond.jpg";

const includes = [
  "Le diffuseur connecté installé chez vous",
  "Votre parfum sur-mesure, en huile pure",
  "Recharges et suivi compris",
  "Pilotage par application",
];

const reassurances = [
  "Audit olfactif offert avant tout devis",
  "Installation et mise en service incluses",
  "Sans frais cachés, résiliable à tout moment",
];
---

<section
  data-offer
  aria-labelledby="offer-title"
  class="relative bg-white"
>
  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <h2
      id="offer-title"
      data-offer-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="max-w-[20ch] font-display font-light leading-[1.1] tracking-[-0.015em] text-[clamp(1.75rem,3.6vw,2.75rem)] text-[var(--color-ink)]"
    >
      Un diffuseur connecté, votre parfum sur-mesure. À partir de 65€/mois.
    </h2>

    <p
      data-offer-reveal
      style="opacity:0;transform:translateY(18px);will-change:opacity,transform;"
      class="mt-6 max-w-[58ch] text-[1rem] font-light leading-[1.6] text-[var(--color-ink-soft)] md:text-[1.0625rem]"
    >
      Tout est compris dans l'abonnement : le matériel, le parfum, les recharges
      et le suivi. Aucun investissement à l'achat.
    </p>

    <div
      class="mt-10 grid grid-cols-1 items-stretch gap-y-8 md:mt-14 md:grid-cols-2 md:gap-x-12 lg:gap-x-16"
    >
      <div
        data-offer-visual
        style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
        class="overflow-hidden border border-[var(--color-border)] bg-white"
      >
        <Image
          src={diffuseur}
          alt="Diffuseur de parfum connecté Guilbert Parfums"
          widths={[480, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 45vw"
          loading="lazy"
          decoding="async"
          class="h-full min-h-[280px] w-full object-cover md:min-h-[440px]"
        />
      </div>

      <div
        data-offer-reveal
        style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
        class="flex flex-col border border-[var(--color-border)] bg-[var(--color-ivory-50)] p-8 md:p-10 lg:p-12"
      >
        <div class="flex items-baseline gap-2">
          <span
            class="font-display text-[clamp(2.5rem,5vw,3.75rem)] font-light leading-none text-[var(--color-bordeaux)]"
          >
            À partir de 65&nbsp;€
          </span>
          <span class="text-[14px] tracking-[0.04em] text-[var(--color-graphite)]">
            /mois
          </span>
        </div>
        <p class="mt-3 text-[14px] text-[var(--color-graphite)]">
          Abonnement mensuel. Sans engagement.
        </p>

        <ul class="mt-8 space-y-3.5 border-t border-[var(--color-border)] pt-8">
          {includes.map((item) => (
            <li class="flex items-start gap-3 text-[15px] text-[var(--color-ink-soft)]">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-ink)"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-[2px] shrink-0"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <div class="mt-9">
          <a
            href="#form"
            class="group inline-flex items-center gap-3 bg-[var(--color-ink)] px-7 py-4 text-[12px] font-medium tracking-[0.01em] text-white transition-colors duration-300 hover:bg-black"
          >
            <span>Créer et diffuser mon parfum</span>
            <svg
              width="16"
              height="10"
              viewBox="0 0 16 10"
              fill="none"
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path
                d="M0 5h14m0 0L10 1m4 4l-4 4"
                stroke="currentColor"
                stroke-width="1.4"></path>
            </svg>
          </a>
        </div>

        <ul
          class="mt-8 space-y-2.5 border-t border-[var(--color-border)] pt-7"
        >
          {reassurances.map((r) => (
            <li class="flex items-start gap-2.5 text-[13px] leading-[1.5] text-[var(--color-graphite)]">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="var(--color-graphite)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-[2px] shrink-0"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {r}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-offer-visual], [data-offer-reveal]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "[data-offer]",
        start: "top 76%",
        once: true,
      },
      defaults: { ease: "power3.out" },
    });

    tl.to("[data-offer-reveal]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.12,
    }).to(
      "[data-offer-visual]",
      { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
      0.1
    );
  }
</script>
