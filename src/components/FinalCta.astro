---
const year = new Date().getFullYear();
---

<footer
  data-final
  aria-labelledby="final-title"
  class="relative bg-[var(--color-ink)] text-[var(--color-ivory)]"
>
  <div class="mx-auto max-w-[1480px] px-6 md:px-10">
    <div class="py-24 md:py-32 lg:py-40">
      <div class="grid grid-cols-1 gap-y-12 md:grid-cols-12 md:gap-x-14 lg:gap-x-20">
        <div class="md:col-span-3 lg:col-span-2">
          <span
            data-final-reveal
            style="opacity:0;transform:translateY(14px);will-change:opacity,transform;"
            class="block text-[10px] uppercase tracking-[0.22em] text-white/45"
          >
            [10] · Le showroom
          </span>
        </div>

        <div class="md:col-span-9 lg:col-span-10">
          <h2
            id="final-title"
            class="font-display font-light leading-[1.04] tracking-[-0.015em] text-[clamp(2.5rem,6vw,5rem)] text-[var(--color-ivory)]"
          >
            <span
              data-final-line
              style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
              class="block"
            >
              Parlons de
            </span>
            <span
              data-final-line
              style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
              class="block text-white/55"
            >
              votre projet.
            </span>
          </h2>

          <p
            data-final-reveal
            style="opacity:0;transform:translateY(18px);will-change:opacity,transform;"
            class="mt-8 max-w-[46ch] text-[1.0625rem] font-light leading-[1.6] text-white/70 md:text-[1.125rem]"
          >
            Votre univers mérite une signature. Laissez-nous la créer. L'audit
            olfactif est offert, partout en France, à distance ou à notre
            showroom parisien.
          </p>

          <div
            data-final-reveal
            style="opacity:0;transform:translateY(18px);will-change:opacity,transform;"
            class="mt-12 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-7"
          >
            <a
              href="#contact"
              class="group inline-flex items-center gap-3 bg-white px-7 py-4 text-[12px] font-medium tracking-[0.01em] text-[var(--color-ink)] transition-colors duration-300 hover:bg-[var(--color-ivory-50)]"
            >
              <span>Créer et diffuser mon parfum</span>
              <svg
                width="16"
                height="10"
                viewBox="0 0 16 10"
                fill="none"
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                <path
                  d="M0 5h14m0 0L10 1m4 4l-4 4"
                  stroke="currentColor"
                  stroke-width="1.4"></path>
              </svg>
            </a>
            <a
              href="tel:+33686537497"
              class="text-[13px] font-medium uppercase tracking-[0.14em] text-white/85 underline decoration-white/30 decoration-1 underline-offset-[5px] transition-colors hover:text-white hover:decoration-white"
            >
              ou Appel gratuit
            </a>
          </div>
        </div>
      </div>

      <div
        data-final-reveal
        style="opacity:0;transform:translateY(18px);will-change:opacity,transform;"
        class="mt-20 grid grid-cols-1 gap-y-10 border-t border-white/12 pt-12 sm:grid-cols-2 md:mt-28 md:grid-cols-4 md:gap-x-10"
      >
        <div>
          <span class="block text-[10px] uppercase tracking-[0.22em] text-white/40">
            Showroom
          </span>
          <p class="mt-3 text-[14px] font-light leading-[1.6] text-white/85">
            29 rue de Bassano<br />75008 Paris<br />
            <span class="text-white/50">Sur rendez-vous</span>
          </p>
        </div>

        <div>
          <span class="block text-[10px] uppercase tracking-[0.22em] text-white/40">
            Téléphone
          </span>
          <p class="mt-3 text-[14px] font-light text-white/85">
            <a
              href="tel:+33686537497"
              class="underline decoration-white/30 decoration-1 underline-offset-[5px] transition-colors hover:text-white hover:decoration-white"
            >
              Appel gratuit
            </a>
          </p>
        </div>

        <div>
          <span class="block text-[10px] uppercase tracking-[0.22em] text-white/40">
            Email
          </span>
          <p class="mt-3 text-[14px] font-light text-white/85">
            <a
              href="mailto:contact@guilbertparfums.com"
              class="transition-colors hover:text-white"
            >
              contact@guilbertparfums.com
            </a>
          </p>
        </div>

        <div class="flex flex-col items-start justify-between gap-8 sm:items-end">
          <img
            src="/logo/logo-guilbert.png"
            alt="Guilbert Parfums"
            width="68"
            height="50"
            class="h-[50px] w-auto opacity-90 invert"
            loading="lazy"
          />
          <span
            class="text-[11px] uppercase tracking-[0.14em] text-white/60 sm:text-right"
          >
            Fabriqué en France<br />© {year} Guilbert Parfums
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-final-reveal], [data-final-line]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "[data-final]",
        start: "top 80%",
        once: true,
      },
      defaults: { ease: "power3.out" },
    });

    tl.to("[data-final-reveal]", { opacity: 1, y: 0, duration: 0.8, stagger: 0.12 }, 0)
      .to(
        "[data-final-line]",
        {
          opacity: 1,
          y: 0,
          duration: 0.95,
          stagger: 0.16,
          ease: "expo.out",
        },
        0.1
      );
  }
</script>
