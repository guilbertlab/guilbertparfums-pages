---
import { Image } from "astro:assets";
import simulatorImg from "../assets/simulator.png";

// Conversion tertiaire : simulateur IA "Hestia" (existant).
const HESTIA_URL = "https://hestia.guilbertparfums.com/";
---

<section
  data-simulator
  aria-labelledby="simulator-title"
  class="relative bg-[var(--color-ivory)]"
>
  <div class="mx-auto max-w-[1480px] px-6 py-20 md:px-10 md:py-28 lg:py-32">
    <div
      data-simulator-card
      style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
      class="grid grid-cols-1 overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-ivory-50)] md:grid-cols-12"
    >
      <div class="relative md:col-span-5 lg:col-span-5">
        <div
          data-simulator-visual
          class="h-[220px] w-full overflow-hidden md:h-full md:min-h-[360px]"
        >
          <Image
            src={simulatorImg}
            alt="Composition olfactive, matières fraîches"
            widths={[480, 768, 1024, 1440]}
            sizes="(max-width: 768px) 100vw, 42vw"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div
        class="flex flex-col justify-center px-7 py-12 md:col-span-7 md:px-12 md:py-16 lg:px-16"
      >
        <span
          class="block text-[10px] uppercase tracking-[0.22em] text-[var(--color-graphite)]"
        >
          Simulateur IA · Hestia
        </span>
        <h2
          id="simulator-title"
          class="mt-6 max-w-[16ch] font-display font-light leading-[1.08] tracking-[-0.015em] text-[clamp(1.875rem,3.8vw,3rem)] text-[var(--color-ink)]"
        >
          Créez votre parfum avec notre IA.
        </h2>
        <p
          class="mt-5 max-w-[50ch] text-[1rem] font-light leading-[1.6] text-[var(--color-ink-soft)] md:text-[1.0625rem]"
        >
          Décrivez votre univers : Hestia compose une première piste olfactive
          sur mesure. Laissez vos coordonnées, nous vous envoyons le résultat
          et nous en discutons.
        </p>

        <div class="mt-9">
          <a
            href={HESTIA_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-hestia-link
            class="group inline-flex items-center gap-3 bg-[var(--color-ink)] px-7 py-4 text-[12px] font-medium uppercase tracking-[0.18em] text-white transition-colors duration-300 hover:bg-black"
          >
            <span>Créer mon parfum</span>
            <svg
              width="16"
              height="10"
              viewBox="0 0 16 10"
              fill="none"
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path
                d="M0 5h14m0 0L10 1m4 4l-4 4"
                stroke="currentColor"
                stroke-width="1.4"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const card = document.querySelector<HTMLElement>("[data-simulator-card]");
  if (card) {
    if (reduceMotion) {
      card.style.opacity = "1";
      card.style.transform = "none";
    } else {
      gsap.to(card, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: "[data-simulator]",
          start: "top 82%",
          once: true,
        },
      });

      gsap.fromTo(
        "[data-simulator-visual] img",
        { scale: 1.12 },
        {
          scale: 1,
          duration: 1.6,
          ease: "power2.out",
          scrollTrigger: {
            trigger: "[data-simulator]",
            start: "top 82%",
            once: true,
          },
        }
      );
    }
  }
</script>
