---
type Reference = {
  alt: string;
  file: string;
  width: number;
  height: number;
  bigger?: boolean;
};

const references: Reference[] = [
  { alt: "Allianz", file: "logo-allianz.png", width: 1280, height: 318 },
  { alt: "Imperial Treasure", file: "logo-imperial-treasure.png", width: 1072, height: 452 },
  { alt: "Grupo Hotusa", file: "logo-grupo-hotusa.png", width: 500, height: 150 },
  { alt: "Hôtel Langlois", file: "logo-hotel-langlois.png", width: 275, height: 183 },
  { alt: "Chinese Business Club", file: "logo-chinese-business-club.png", width: 290, height: 158 },
  { alt: "Agora", file: "logo-agora.png", width: 200, height: 200, bigger: true },
  { alt: "Xanlite", file: "logo-xanlite.png", width: 222, height: 227, bigger: true },
];
---

<section
  data-references
  aria-labelledby="references-label"
  class="relative bg-[var(--color-ivory)]"
>
  <div class="mx-auto max-w-[1480px] px-6 md:px-10">
    <div
      class="border-t border-[var(--color-border)] py-14 md:py-20"
    >
      <div
        class="grid grid-cols-1 items-center gap-y-10 md:grid-cols-[260px_1fr] md:gap-x-14 lg:gap-x-20"
      >
        <div
          data-ref-label
          style="opacity:0;transform:translateY(14px);will-change:opacity,transform;"
        >
          <span
            class="block text-[10px] uppercase tracking-[0.22em] text-[var(--color-graphite)]"
          >
            [02] · Références
          </span>
          <p
            id="references-label"
            class="mt-3 max-w-[220px] text-[14px] font-light leading-snug text-[var(--color-ink-soft)]"
          >
            Ils nous font confiance : marques, hôtels et lieux d'exception.
          </p>
        </div>

        <ul
          class="flex flex-wrap items-center gap-x-9 gap-y-7 md:gap-x-12 lg:gap-x-14"
        >
          {references.map((ref, i) => (
            <li
              data-ref-item
              data-ref-index={i}
              style="opacity:0;transform:translateY(14px);will-change:opacity,transform;"
              class="flex items-center"
            >
              <img
                src={`/images/${ref.file}`}
                alt={ref.alt}
                width={ref.width}
                height={ref.height}
                loading="lazy"
                decoding="async"
                class={`logo-reference w-auto object-contain ${ref.bigger ? "h-[60px] md:h-[84px] lg:h-[96px]" : "h-6 md:h-8 lg:h-9"}`}
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .logo-reference {
    filter: grayscale(1) contrast(1.05) brightness(0.55);
    mix-blend-mode: multiply;
    opacity: 0.85;
    transition: filter 350ms ease, opacity 350ms ease;
  }

  @media (hover: hover) {
    .logo-reference:hover {
      filter: grayscale(1) contrast(1.1) brightness(0.35);
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-ref-label], [data-ref-item]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    gsap.to("[data-ref-label]", {
      opacity: 1,
      y: 0,
      duration: 0.85,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-references]",
        start: "top 82%",
        once: true,
      },
    });

    gsap.to("[data-ref-item]", {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: "power3.out",
      stagger: 0.07,
      scrollTrigger: {
        trigger: "[data-references]",
        start: "top 78%",
        once: true,
      },
    });
  }
</script>
