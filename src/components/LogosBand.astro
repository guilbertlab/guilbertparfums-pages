---
type Reference = {
  alt: string;
  file: string;
  width: number;
  height: number;
  bigger?: boolean;
  medium?: boolean;
};

const references: Reference[] = [
  { alt: "Allianz", file: "logo-allianz.png", width: 1280, height: 318 },
  { alt: "Imperial Treasure", file: "logo-imperial-treasure.png", width: 1072, height: 452 },
  { alt: "Grupo Hotusa", file: "logo-grupo-hotusa.png", width: 500, height: 150 },
  { alt: "Hôtel Langlois", file: "logo-hotel-langlois.png", width: 275, height: 183 },
  { alt: "Chinese Business Club", file: "logo-chinese-business-club.png", width: 290, height: 158, medium: true },
  { alt: "Agora", file: "logo-agora.png", width: 200, height: 200, bigger: true },
  { alt: "Xanlite", file: "logo-xanlite.png", width: 222, height: 227, bigger: true },
];
---

<section
  aria-label="Ils nous font confiance"
  class="relative bg-[var(--color-ivory-50)]"
>
  <div class="mx-auto max-w-[1480px] px-6 py-14 md:px-10 md:py-16">
    <p
      class="text-center text-[11px] uppercase tracking-[0.22em] text-[var(--color-graphite)]"
    >
      Ils nous font confiance
    </p>

    <ul
      class="mt-8 flex flex-wrap items-center justify-center gap-x-9 gap-y-7 md:mt-10 md:gap-x-12 lg:gap-x-14"
    >
      {references.map((ref) => (
        <li class="flex items-center">
          <img
            src={`/images/${ref.file}`}
            alt={ref.alt}
            width={ref.width}
            height={ref.height}
            loading="lazy"
            decoding="async"
            class={`logo-reference w-auto object-contain ${ref.bigger ? "h-[56px] md:h-[76px] lg:h-[84px]" : ref.medium ? "h-9 md:h-11 lg:h-12" : "h-6 md:h-7 lg:h-8"}`}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .logo-reference {
    filter: grayscale(1) contrast(1.05) brightness(0.55);
    mix-blend-mode: multiply;
    opacity: 0.8;
  }
</style>
