---
// Chiffres clés en attendant les vrais témoignages clients.
// Valeurs PROVISOIRES à faire valider / corriger par le client.
const stats: { value: string; label: string }[] = [
  { value: "80", label: "lieux équipés en France" },
  { value: "99 %", label: "de clients qui renouvellent" },
];

// --- Témoignages réels (à intégrer plus tard) ---------------------------
// Quand les vrais témoignages sont disponibles, remplir ce tableau et
// remplacer le bloc <ul> des chiffres par une liste de <figure> :
//   nom + fonction + établissement + citation + note (étoiles sur 5).
// type Testimonial = {
//   quote: string;
//   name: string;
//   role: string;
//   place: string;
//   rating: number; // 1 à 5
// };
// const testimonials: Testimonial[] = [];
// -----------------------------------------------------------------------
---

<section
  data-stats
  aria-labelledby="stats-title"
  class="relative bg-white"
>
  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <h2
      id="stats-title"
      data-stats-reveal
      style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
      class="font-display font-light leading-[1.1] tracking-[-0.015em] text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-ink)]"
    >
      Guilbert Parfums en chiffres
    </h2>

    <ul
      class="mt-12 grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 md:mt-16"
    >
      {stats.map((s) => (
        <li
          data-stats-item
          style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
          class="border-t border-[var(--color-border)] pt-7"
        >
          <span
            class="block font-display text-[clamp(3.25rem,7vw,5rem)] font-light leading-[0.95] text-[var(--color-bordeaux)]"
          >
            {s.value}
          </span>
          <span
            class="mt-3 block max-w-[18ch] text-[1rem] font-light leading-[1.4] text-[var(--color-ink-soft)]"
          >
            {s.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-stats-reveal], [data-stats-item]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    gsap.to("[data-stats-reveal]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-stats]",
        start: "top 80%",
        once: true,
      },
    });

    gsap.to("[data-stats-item]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.14,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-stats-item]",
        start: "top 84%",
        once: true,
      },
    });
  }
</script>
