---
import { Image } from "astro:assets";
import vapeur from "../assets/vapeur.png";
---

<section
  data-promise
  aria-labelledby="promise-title"
  class="relative bg-[var(--color-ivory-50)]"
>
  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <div
      class="grid grid-cols-1 items-center gap-y-10 md:grid-cols-2 md:gap-x-12 lg:gap-x-20"
    >
      <div
        data-promise-visual
        style="opacity:0;will-change:opacity;"
        class="order-first overflow-hidden md:order-none"
      >
        <Image
          src={vapeur}
          alt="Sillage de parfum dans la lumière"
          widths={[480, 768, 1024, 1280]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="lazy"
          decoding="async"
          class="h-[280px] w-full object-cover md:h-[480px] lg:h-[600px]"
        />
      </div>

      <div>
        <h2
          id="promise-title"
          class="font-display font-light leading-[1.1] tracking-[-0.015em] text-[clamp(1.875rem,3.8vw,3rem)] text-[var(--color-ink)]"
        >
          <span
            data-promise-line
            style="opacity:0;transform:translateY(22px);will-change:opacity,transform;"
            class="block"
          >
            Vos clients oublient ce qu'ils ont vu chez vous.
          </span>
          <span
            data-promise-line
            style="opacity:0;transform:translateY(22px);will-change:opacity,transform;"
            class="block text-[var(--color-graphite)]"
          >
            Pas ce qu'ils ont senti.
          </span>
        </h2>

        <p
          data-promise-p
          style="opacity:0;transform:translateY(16px);will-change:opacity,transform;"
          class="mt-8 max-w-[52ch] text-[1.0625rem] font-light leading-[1.6] text-[var(--color-ink-soft)]"
        >
          Une odeur reste. Plus longtemps qu'une affiche, plus profondément
          qu'un visuel. C'est elle qui marque les esprits et qui fait revenir
          vos clients. Chez Guilbert, nous composons une fragrance à votre
          image, au Pays de Grasse, en huile de parfum pure.
        </p>

        <p
          data-promise-quote
          style="opacity:0;transform:translateY(18px);will-change:opacity,transform;"
          class="mt-8 max-w-[22ch] border-t border-[var(--color-border)] pt-8 font-display text-[clamp(1.5rem,2.6vw,2rem)] font-light leading-[1.25] tracking-[-0.01em] text-[var(--color-ink)]"
        >
          Un parfum qu'aucune autre marque ne porte. Le vôtre.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>(
        "[data-promise-visual], [data-promise-line], [data-promise-p], [data-promise-quote]"
      )
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "[data-promise]",
        start: "top 78%",
        once: true,
      },
      defaults: { ease: "power3.out" },
    });

    tl.to(
      "[data-promise-visual]",
      { opacity: 1, duration: 1.0, ease: "power2.out" },
      0
    )
      .to(
        "[data-promise-line]",
        { opacity: 1, y: 0, duration: 0.9, stagger: 0.16, ease: "expo.out" },
        0.15
      )
      .to(
        "[data-promise-p]",
        { opacity: 1, y: 0, duration: 0.8 },
        0.55
      )
      .to(
        "[data-promise-quote]",
        { opacity: 1, y: 0, duration: 0.8 },
        0.72
      );
  }
</script>
