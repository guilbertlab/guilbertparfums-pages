---
import { Image } from "astro:assets";
import imgCreation from "../assets/pillars.png";
import imgDiffusion from "../assets/pillar-diffusion.jpg";
import imgMerch from "../assets/pillar-merch.jpg";

type Pillar = {
  n: string;
  title: string;
  desc: string;
  image: ImageMetadata;
  alt: string;
};

const pillars: Pillar[] = [
  {
    n: "01",
    title: "Création sur-mesure",
    desc: "Nos parfumeurs composent votre signature olfactive au Pays de Grasse, en huile de parfum pure. Une identité construite à partir de votre histoire, pas une fragrance de catalogue diluée.",
    image: imgCreation,
    alt: "Composition d'une fragrance sur-mesure au Pays de Grasse",
  },
  {
    n: "02",
    title: "Diffusion connectée",
    desc: "Des diffuseurs que vous pilotez depuis une application : intensité, plages horaires, zones. Le parfum suit votre lieu et vos heures d'affluence.",
    image: imgDiffusion,
    alt: "Diffuseur connecté Guilbert Parfums en situation",
  },
  {
    n: "03",
    title: "Merchandising",
    desc: "Déclinez votre parfum en bougies, savons et soins. Vos clients repartent avec votre univers, et vous ouvrez une nouvelle source de revenus.",
    image: imgMerch,
    alt: "Gamme de bougies et savons Guilbert Parfums",
  },
];
---

<section
  data-pillars
  aria-labelledby="pillars-title"
  class="relative bg-white"
>
  <div class="mx-auto max-w-[1480px] px-6 py-24 md:px-10 md:py-28 lg:py-32">
    <h2
      id="pillars-title"
      class="font-display font-light leading-[1.05] tracking-[-0.015em] text-[clamp(2rem,4vw,3.25rem)] text-[var(--color-ink)]"
    >
      <span
        data-pillars-line
        style="opacity:0;transform:translateY(22px);will-change:opacity,transform;"
        class="block"
      >
        Créez-le.
      </span>
      <span
        data-pillars-line
        style="opacity:0;transform:translateY(22px);will-change:opacity,transform;"
        class="block"
      >
        Diffusez-le.
      </span>
      <span
        data-pillars-line
        style="opacity:0;transform:translateY(22px);will-change:opacity,transform;"
        class="block"
      >
        Vendez-le.
      </span>
    </h2>

    <ul
      class="mt-14 grid grid-cols-1 gap-x-10 gap-y-12 md:mt-20 md:grid-cols-3 md:gap-x-12"
    >
      {pillars.map((p) => (
        <li
          data-pillar-card
          style="opacity:0;transform:translateY(26px);will-change:opacity,transform;"
        >
          <div class="overflow-hidden">
            <Image
              src={p.image}
              alt={p.alt}
              widths={[400, 640, 900]}
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              decoding="async"
              class="h-[240px] w-full object-cover lg:h-[280px]"
            />
          </div>
          <span
            class="mt-6 block font-display text-[1.5rem] font-light leading-none text-[var(--color-stone)]"
          >
            {p.n}
          </span>
          <h3
            class="mt-3 font-display text-[1.375rem] font-light tracking-[-0.01em] text-[var(--color-ink)] md:text-[1.5rem]"
          >
            {p.title}
          </h3>
          <p
            class="mt-3 text-[0.9375rem] font-light leading-[1.6] text-[var(--color-ink-soft)] md:text-[1rem]"
          >
            {p.desc}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>("[data-pillars-line], [data-pillar-card]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    gsap.to("[data-pillars-line]", {
      opacity: 1,
      y: 0,
      duration: 0.9,
      stagger: 0.14,
      ease: "expo.out",
      scrollTrigger: {
        trigger: "[data-pillars]",
        start: "top 78%",
        once: true,
      },
    });

    gsap.to("[data-pillar-card]", {
      opacity: 1,
      y: 0,
      duration: 0.85,
      stagger: 0.14,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-pillar-card]",
        start: "top 82%",
        once: true,
      },
    });
  }
</script>
