---
import { Image } from "astro:assets";
import imgCreation from "../assets/pillars.png";
import imgDiffusion from "../assets/pillar-diffusion.jpg";
import imgMerch from "../assets/pillar-merch.jpg";

type Pillar = {
  n: string;
  title: string;
  desc: string;
  image: ImageMetadata;
  alt: string;
};

const pillars: Pillar[] = [
  {
    n: "01",
    title: "Création sur-mesure",
    desc: "Nos parfumeurs composent votre signature olfactive au Pays de Grasse, en huile de parfum pure. Une identité construite à partir de votre histoire, pas une fragrance de catalogue diluée.",
    image: imgCreation,
    alt: "Composition d'une fragrance sur-mesure au Pays de Grasse",
  },
  {
    n: "02",
    title: "Diffusion connectée",
    desc: "Des diffuseurs que vous pilotez depuis une application : intensité, plages horaires, zones. Le parfum suit votre lieu et vos heures d'affluence. Vous gardez le contrôle.",
    image: imgDiffusion,
    alt: "Diffuseur connecté Guilbert Parfums",
  },
  {
    n: "03",
    title: "Merchandising",
    desc: "Déclinez votre parfum en bougies, savons et soins fabriqués en France. Vos clients repartent avec votre univers, et vous ouvrez une nouvelle source de revenus.",
    image: imgMerch,
    alt: "Packaging et gamme de produits Guilbert Parfums",
  },
];
---

<section
  data-pillars
  aria-labelledby="pillars-title"
  class="relative bg-[var(--color-ivory)]"
>
  <div class="mx-auto max-w-[1480px] px-6 md:px-10">
    <div class="border-t border-[var(--color-border)] py-24 md:py-32 lg:py-40">
      <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-14 lg:gap-x-20">
        <div class="md:col-span-3 lg:col-span-2">
          <span
            data-pillars-eyebrow
            style="opacity:0;transform:translateY(14px);will-change:opacity,transform;"
            class="block text-[10px] uppercase tracking-[0.22em] text-[var(--color-graphite)]"
          >
            [04] · La solution
          </span>
        </div>

        <div class="md:col-span-9 lg:col-span-10">
          <h2
            id="pillars-title"
            class="font-display font-light leading-[1.04] tracking-[-0.015em] text-[clamp(2.25rem,5.4vw,4.5rem)] text-[var(--color-ink)]"
          >
            <span
              data-pillars-line
              style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
              class="block"
            >
              Créez-le.
            </span>
            <span
              data-pillars-line
              style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
              class="block"
            >
              Diffusez-le.
            </span>
            <span
              data-pillars-line
              style="opacity:0;transform:translateY(24px);will-change:opacity,transform;"
              class="block"
            >
              Vendez-le.
            </span>
          </h2>
        </div>
      </div>

      <ul class="mt-16 md:mt-24 lg:mt-28">
        {pillars.map((p, i) => (
          <li
            data-pillar-row
            style="opacity:0;transform:translateY(28px);will-change:opacity,transform;"
            class="border-t border-[var(--color-border)] py-12 md:py-16 lg:py-20"
          >
            <div class="grid grid-cols-1 items-center gap-y-8 md:grid-cols-2 md:gap-x-14 lg:gap-x-20">
              <div
                class:list={[
                  "overflow-hidden",
                  i % 2 === 1 && "md:order-2",
                ]}
              >
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[480, 768, 1024, 1280]}
                  sizes="(max-width: 768px) 100vw, 45vw"
                  loading="lazy"
                  decoding="async"
                  class="h-[280px] w-full object-cover md:h-[420px] lg:h-[460px]"
                />
              </div>

              <div class:list={[i % 2 === 1 && "md:order-1"]}>
                <span
                  class="font-display text-[2.5rem] font-light leading-none text-[var(--color-stone)] md:text-[3rem] lg:text-[3.5rem]"
                >
                  {p.n}
                </span>
                <h3
                  class="mt-5 font-display text-[1.5rem] font-light tracking-[-0.01em] text-[var(--color-ink)] md:text-[1.75rem] lg:text-[2rem]"
                >
                  {p.title}
                </h3>
                <p
                  class="mt-4 max-w-[48ch] text-[1rem] font-light leading-[1.6] text-[var(--color-ink-soft)] md:text-[1.0625rem]"
                >
                  {p.desc}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div
        data-pillars-cta
        style="opacity:0;transform:translateY(20px);will-change:opacity,transform;"
        class="mt-16 border-t border-[var(--color-border)] pt-12 md:mt-20 md:pt-16"
      >
        <a
          href="#audit"
          class="group inline-flex items-center gap-3 bg-[var(--color-ink)] px-7 py-4 text-[12px] font-medium uppercase tracking-[0.18em] text-white transition-colors duration-300 hover:bg-black"
        >
          <span>Réserver un audit olfactif offert</span>
          <svg
            width="16"
            height="10"
            viewBox="0 0 16 10"
            fill="none"
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path
              d="M0 5h14m0 0L10 1m4 4l-4 4"
              stroke="currentColor"
              stroke-width="1.4"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (reduceMotion) {
    document
      .querySelectorAll<HTMLElement>(
        "[data-pillars-eyebrow], [data-pillars-line], [data-pillar-row], [data-pillars-cta]"
      )
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "[data-pillars]",
        start: "top 78%",
        once: true,
      },
      defaults: { ease: "power3.out" },
    });

    tl.to("[data-pillars-eyebrow]", { opacity: 1, y: 0, duration: 0.7 }, 0)
      .to(
        "[data-pillars-line]",
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          stagger: 0.14,
          ease: "expo.out",
        },
        0.15
      );

    gsap.utils.toArray<HTMLElement>("[data-pillar-row]").forEach((row) => {
      gsap.to(row, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: {
          trigger: row,
          start: "top 82%",
          once: true,
        },
      });
    });

    gsap.to("[data-pillars-cta]", {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "[data-pillars-cta]",
        start: "top 88%",
        once: true,
      },
    });
  }
</script>
