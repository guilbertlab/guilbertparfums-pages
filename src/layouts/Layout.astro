---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Guilbert Parfums - Diffusion de parfums pour professionnels",
  description = "Maison française de parfums d'ambiance fabriqués en France, à Grasse, berceau historique de la parfumerie. Signature olfactive sur-mesure, diffuseurs connectés, partout en France. Audit olfactif offert, sans engagement.",
  noindex = true,
} = Astro.props;

const ogImage = new URL("/og-image.jpg", Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1448" />
    <meta property="og:image:height" content="1086" />
    <meta property="og:image:alt" content="Diffuseur de parfum Guilbert Parfums" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/logo/monogram-noir.svg" />

    <link
      rel="preload"
      href="/fonts/Arpona Light.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Arpona Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Arpona Medium.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
  </head>

  <body class="bg-[var(--color-ivory)] text-[var(--color-ink)]">
    <slot />
  </body>
</html>
