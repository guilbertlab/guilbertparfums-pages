---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import LogosBand from "../components/LogosBand.astro";
import Offer from "../components/Offer.astro";
import Promise from "../components/Promise.astro";
import Pillars from "../components/Pillars.astro";
import Industries from "../components/Industries.astro";
import WhyUs from "../components/WhyUs.astro";
import Process from "../components/Process.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import StickyCta from "../components/StickyCta.astro";
---

<Layout>
  <Header variant="over-hero-light" />
  <main>
    <Hero />
    <LogosBand />
    <Offer />
    <Promise />
    <WhyUs />
    <Pillars />
    <Process />
    <Industries />
    <Testimonials />
    <Faq />
  </main>
  <FinalCta />
  <StickyCta />
</Layout>
